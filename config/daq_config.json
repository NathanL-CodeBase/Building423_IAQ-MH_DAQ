"aio2": {
    "description": "Met One AIO 2 sonic weather sensor over RS-485 to USB, 9600 8N1, 1 Hz ASCII, comma-delimited. Metric defaults are SI.",
    "baud_rate": 9600,
    "bytesize": 8,
    "parity": "N",
    "stopbits": 1,
    "field_names": [
      "wind_speed", "wind_direction", "air_temp", "relative_humidity",
      "barometric_pressure", "rain", "solar_radiation", "battery_voltage",
      "compass_heading", "config", "checksum"
    ],
    "output_columns": [
      {"field": "wind_speed",          "header": "Wind_Speed_m/s",           "si_unit": "m/s",     "present": true},
      {"field": "wind_direction",      "header": "Wind_Direction_deg",       "si_unit": "deg",     "present": true,  "note": "Referenced to magnetic north; no declination set via MD command. For true north, set declination at the sensor."},
      {"field": "air_temp",            "header": "Ambient_Temperature_degC", "si_unit": "degC",    "present": true},
      {"field": "relative_humidity",   "header": "Relative_Humidity_%",      "si_unit": "percent", "present": true},
      {"field": "barometric_pressure", "header": "Barometric_Pressure_mb",   "si_unit": "hPa",     "present": true,  "note": "1 mb equals 1 hPa; header kept as mb for continuity with prior files."},
      {"field": "rain",                "header": "Rain_mm",                  "si_unit": "mm",      "present": false, "note": "External contact-closure rain gauge not connected. Column may read 0 until a gauge is added."},
      {"field": "solar_radiation",     "header": "Solar_Radiation_W/m2",     "si_unit": "W/m2",    "present": false, "note": "External solar sensor (Met One 096A-2) not connected. Column may read 0 until a sensor is added."},
      {"field": "battery_voltage",     "header": "Battery_Voltage_V",        "si_unit": "V",       "present": true,  "note": "Present in the serial string only when BV is enabled at the sensor. Verify BV1 is set."},
      {"field": "compass_heading",     "header": "Compass_Heading_deg",      "si_unit": "deg",     "present": true,  "note": "Present in the serial string only when CV is enabled at the sensor. Verify CV1 is set."}
    ],
    "notes": "Standard serial string per AIO 2-9800 Rev E is WS,WD,AT,RH,BP,RN,SR,BV,CONFIG,CheckSum. Battery voltage (BV) and compass heading (CV) appear only when toggled on at the sensor, so the field count varies. The Step 3 parser maps fields by count and validates each line with the checksum (decimal sum of all characters from the start of the message through the character before the asterisk). CONFIG and CheckSum are metadata, not logged as data columns."
  },
  "alarms": {
    "email": {
      "enabled": true,
      "min_interval_s": 300,
      "notes": "min_interval_s throttles repeat emails per rule so a stuck condition does not flood the inbox."
    },
    "quality": {
      "dropout_s": 30,
      "stale_s": 60,
      "frozen_count": 60,
      "notes": "dropout_s: no new record. stale_s: newest record older than this. frozen_count: identical value repeated this many records."
    },
    "rules": [
      {
        "channel": "T_Gar_M5_C4",
        "description": "Garage over-temperature",
        "high": 28.0,
        "low": null,
        "dwell_s": 60,
        "unit": "degC"
      },
      {
        "channel": "T_Gar_M5_C4",
        "description": "Garage under-temperature",
        "high": null,
        "low": 15.0,
        "dwell_s": 60,
        "unit": "degC"
      }
    ]
  },
  "display_ranges": {
    "notes": "Group dashboard value-card colors only; these are not alarms and send no email. A value below low shows blue, above high shows red, and a value equal to a limit shows normal. Comparison uses the value as displayed (2 decimals). Living-space zones only: garage, attic, outdoor, HVAC supply, and blower channels are left uncolored.",
    "rules": [
      {
        "name": "Living-space temperature",
        "unit": "degC",
        "low": 18.0,
        "high": 25.0,
        "channels": [
          "T_Bed1_M4_C4", "T_Bed2_M4_C5", "T_Bed3_M4_C6", "T_Liv_M4_C7",
          "T_Fam_M5_C0", "T_MBa_M5_C1", "T_Ba1_M5_C2", "T_UR_M5_C3"
        ]
      },
      {
        "name": "Living-space relative humidity",
        "unit": "percent",
        "low": 40.0,
        "high": 60.0,
        "channels": [
          "RH_Bed1_M3_C0", "RH_Bed2_M3_C1", "RH_Bed3_M3_C2", "RH_Liv_M3_C3",
          "RH_Fam_M3_C4", "RH_MBa_M3_C5", "RH_Ba1_M3_C6", "RH_UR_M3_C7"
        ]
      }
    ]
  }
}