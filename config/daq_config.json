{
  "config_version": "1.0",
  "description": "MH cDAQ-9178 and Met One AIO 2 channel map, scales, and alarms. Committed, non-secret. Coefficients from NI MAX export cDAQ_Config.txt (rebuilt Aug 2026).",
  "acquisition": {
    "oversample_rate_hz": 1000,
    "samples_per_record": 100,
    "record_rate_hz": 1,
    "notes": "Matches NI MAX task: 1 kHz clock, 100 samples averaged to one 1 Hz record."
  },
  "mirror": {
    "snapshot_interval_s": 60,
    "inprogress_interval_s": 300,
    "retry_interval_s": 30,
    "mission_subdir": "mh_daq",
    "notes": "snapshot_interval_s: how often to push latest_snapshot.json to Mission. inprogress_interval_s: how often to push the current day's still-open daily files (0 means only at rollover); remote dashboards in mission mode see today's trends only as fresh as this. retry_interval_s: base tick and retry cadence. mission_subdir: namespace under mission_data_dir for this system's files, keeping them separate from the LabVIEW-era indoor_daq and weather_station folders."
  },
